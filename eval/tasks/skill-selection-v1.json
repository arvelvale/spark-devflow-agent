{
  "version": 1,
  "name": "skill-selection-v1",
  "description": "开发流技能选择基础集 v0（晨熠/Claude 起草，skills 优化同学扩充）：单技能 16、无技能 7、组合 3。近义组：progress-logger / standup-brief / status-sync。",
  "tasks": [
    {"id": "sel-001", "category": "single", "input": "把 DAY-5 拆一下",
     "expect": {"skills": ["issue-breakdown"], "confusable": ["plan-writer"], "tier": "local"}},
    {"id": "sel-002", "category": "single", "input": "CSV 导出那个 issue 太大了，拆成几个小任务建到 Linear 上",
     "expect": {"skills": ["issue-breakdown"], "confusable": ["meeting-to-tasks"]}},
    {"id": "sel-003", "category": "single", "input": "金额精度这个问题准备怎么改？先出一份方案文档，别动代码",
     "expect": {"skills": ["plan-writer"], "confusable": ["implement-change"], "tier": "local"},
     "note": "'别动代码'是关键：只写计划"},
    {"id": "sel-004", "category": "single", "input": "月度汇总开工前写个 plan 放到 docs/plans",
     "expect": {"skills": ["plan-writer"], "confusable": ["issue-breakdown"]}},
    {"id": "sel-005", "category": "single", "input": "把金额累加精度的 bug 修掉，记得补测试",
     "expect": {"skills": ["implement-change"], "confusable": ["plan-writer"], "tier": "cloud"}},
    {"id": "sel-006", "category": "single", "input": "按 docs/plans 里的计划把 CSV 导出做出来",
     "expect": {"skills": ["implement-change"], "confusable": ["plan-writer"], "tier": "cloud"}},
    {"id": "sel-007", "category": "single", "input": "把今天改的几个提交整理一下，落到 docs/progress 里",
     "expect": {"skills": ["progress-logger"], "confusable": ["standup-brief"], "tier": "local"},
     "tags": ["近义组"], "note": "关键词是落到文件；站会简报不落文件"},
    {"id": "sel-008", "category": "single", "input": "补一下 9 月 23 号的开发日志",
     "expect": {"skills": ["progress-logger"], "confusable": ["status-sync"]}, "tags": ["近义组"]},
    {"id": "sel-009", "category": "single", "input": "待会开站会，帮我理一下昨天干了啥今天干啥",
     "expect": {"skills": ["standup-brief"], "confusable": ["progress-logger"], "tier": "local"}, "tags": ["近义组"]},
    {"id": "sel-010", "category": "single", "input": "现在项目卡在哪些事情上？给我个简短的进度汇报",
     "expect": {"skills": ["standup-brief"], "confusable": ["status-sync"]}, "tags": ["近义组"]},
    {"id": "sel-011", "category": "single", "input": "精度 bug 修完了，去 Linear 上把状态改成完成",
     "expect": {"skills": ["status-sync"], "confusable": ["progress-logger"], "tier": "local"}, "tags": ["近义组"]},
    {"id": "sel-012", "category": "single", "input": "同步一下 Linear 上几个 issue 的进度",
     "expect": {"skills": ["status-sync"], "confusable": ["standup-brief"]}, "tags": ["近义组"]},
    {"id": "sel-013", "category": "single", "input": "帮我 review 一下当前分支，看有没有违反 AGENTS.md",
     "expect": {"skills": ["review-gate"], "confusable": ["implement-change"]}},
    {"id": "sel-014", "category": "single", "input": "这个分支能合进 main 吗",
     "expect": {"skills": ["review-gate"]}},
    {"id": "sel-015", "category": "single", "input": "把昨天周会纪要里的待办建成 Linear 任务",
     "expect": {"skills": ["meeting-to-tasks"], "confusable": ["issue-breakdown"]}},
    {"id": "sel-016", "category": "single", "input": "需求评审那篇纪要，转成 issue",
     "expect": {"skills": ["meeting-to-tasks"], "confusable": ["issue-breakdown"]}},
    {"id": "sel-017", "category": "none", "input": "git rebase 和 merge 有什么区别",
     "expect": {"skills": [], "tier": "local"}},
    {"id": "sel-018", "category": "none", "input": "Python 里用 Decimal 和按分存整数，哪个更适合记账？",
     "expect": {"skills": [], "confusable": ["plan-writer"]}, "note": "概念比较，不是要写计划"},
    {"id": "sel-019", "category": "none", "input": "周会纪要里说了些什么？简单概括下",
     "expect": {"skills": [], "confusable": ["meeting-to-tasks", "standup-brief"]},
     "note": "只读纪要回答即可，meeting-to-tasks 的 not-for 明确排除了这种说法"},
    {"id": "sel-020", "category": "none", "input": "你好，你是谁",
     "expect": {"skills": []}},
    {"id": "sel-021", "category": "none", "input": "解释一下 UTF-8 BOM 是什么",
     "expect": {"skills": []}},
    {"id": "sel-022", "category": "none", "input": "最近 3 条提交是什么",
     "expect": {"skills": [], "confusable": ["progress-logger", "standup-brief"]},
     "note": "一次只读查询，不需要流程"},
    {"id": "sel-023", "category": "none", "input": "tinyledger 的 list 命令是怎么实现的？",
     "expect": {"skills": [], "confusable": ["review-gate"]}},
    {"id": "sel-024", "category": "multi", "input": "把金额精度 bug 修了，然后在 Linear 上把这个 issue 关掉",
     "expect": {"skills": ["implement-change", "status-sync"], "tier": "cloud"}},
    {"id": "sel-025", "category": "multi", "input": "今天的日志写一下，顺便把 Linear 状态也同步了",
     "expect": {"skills": ["progress-logger", "status-sync"]}},
    {"id": "sel-026", "category": "multi", "input": "先给 CSV 导出写个计划，然后按计划实现",
     "expect": {"skills": ["plan-writer", "implement-change"]}}
  ]
}
